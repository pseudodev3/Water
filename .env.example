PORT=8080
GECKOTERMINAL_API_HOST=https://api.geckoterminal.com/api/v2
DEXSCREENER_API_HOST=https://api.dexscreener.com
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_FALLBACK_RPC_URL=https://solana-rpc.publicnode.com
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
BLOCKSCOUT_API_URL=https://api.blockscout.com/4663/api/v2
BLOCKSCOUT_API_KEY=
NEXT_PUBLIC_WATER_API_URL=http://localhost:8080

# Wallet collection is paused until a database path is set.
# Production: mount a persistent volume and use /data/water/wallets.sqlite.
WATER_TRACKER_DB_PATH=
HELIUS_API_KEY=
# Optional credential failover. These keys share one Water budget; they do not
# multiply a Helius project's 1M-credit plan. Keep the singular key for one key.
HELIUS_API_KEYS=
WATER_TRACKER_HELIUS_CREDITS_31D=800000
BNB_RPC_URL=https://bsc-rpc.publicnode.com
BNB_FALLBACK_RPC_URL=https://bsc-dataseed.bnbchain.org
BNB_TRACE_RPC_URL=https://bsc.drpc.org
# Optional independent discovery API, not a Fomo login/session token.
FOMO_DISCOVERY_API_KEY=
ROBINHOOD_TRACE_RPC_URL=https://robinhood.drpc.org
WATER_TRACKER_INTERVAL_SECONDS=60
WATER_TRACKER_COHORT_LIMIT=12
WATER_TRACKER_DAILY_REQUESTS=2000
WATER_TRACKER_RECORD_LIMIT=10000
# Enable only on a private/restricted deployment; consumes the shared cohort.
WATER_TRACKER_ALLOW_PUBLIC_NOMINATIONS=false
# Optional custom CA bundle for trusted outbound proxies; TLS stays verified.
# SSL_CERT_FILE=/path/to/ca-bundle.pem
